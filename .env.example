# UENR Portal — example environment configuration.
# Copy to .env and fill in real values. NEVER commit the real .env file.

# --- Core Django -------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# 1 = development (verbose errors, HTTP allowed); 0 = production (HSTS, HTTPS, secure cookies)
DJANGO_DEBUG=1
# Comma-separated hosts allowed to serve the site in production
DJANGO_ALLOWED_HOSTS=.vercel.app,localhost,127.0.0.1
# Origins allowed for POSTs in production (scheme required)
DJANGO_CSRF_TRUSTED_ORIGINS=https://*.vercel.app

# --- Email (password reset) --------------------------------------------------
# Leave EMAIL_HOST_USER empty to print reset links to the console (dev mode).
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@uenr.edu.gh
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
