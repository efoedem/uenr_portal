# GitHub Actions CI for the UENR Portal.
# NOTE: For this to run automatically, move this file to:
#   .github/workflows/ci.yml
# (The connector used to author this repo cannot write under .github/.)
name: CI
on:
  push:
    branches:
      - main
      - "feature/**"
  pull_request:
    branches:
      - main
jobs:
  test:
    runs-on: ubuntu-latest
    env:
      DJANGO_SECRET_KEY: ci-test-key-not-for-production
      DJANGO_DEBUG: "1"
    steps:
      - name: Checkout
        uses: actions/checkout@v4
      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"
          cache: pip
      - name: Install dependencies
        run: pip install -r requirements.txt
      - name: Django system checks
        run: python manage.py check
      - name: Migration drift check
        run: python manage.py makemigrations --check --dry-run
      - name: Run test suite
        run: python manage.py test -v 2
